# RMS Standalone API Server Environment Configuration
NODE_ENV=development
PORT=4000

# Rate Limiting Configuration
API_RATE_LIMIT=100
API_RATE_WINDOW_MS=60000

# CORS Allowed Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000

# Firebase Admin SDK Credentials (Production Service Account)
# Option A: Direct environment variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Path to Service Account JSON file (optional)
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
